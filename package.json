{
  "name": "trophypilot",
  "version": "0.1.0",
  "private": true,
  "description": "TrophyPilot: PlayStation trophy tracking, guides and leaderboards",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "setup:live": "prisma db push",
    "psn:check": "tsx scripts/psn-check.ts",
    "psn:import": "tsx scripts/psn-import.ts",
    "psn:track": "tsx scripts/psn-track.ts",
    "psn:discover": "tsx scripts/psn-discover.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo:user": "tsx scripts/demo-user.ts",
    "db:recompute-progress": "tsx scripts/recompute-progress.ts",
    "db:from-sqlite": "tsx scripts/sqlite-to-postgres.ts",
    "db:backfill-titles": "tsx scripts/backfill-titles.ts",
    "db:estimates": "tsx scripts/refresh-estimates.ts",
    "igdb:import": "tsx scripts/igdb-import.ts",
    "user:role": "tsx scripts/user-role.ts",
    "psn:lists": "tsx scripts/psn-lists.ts",
    "psn:player-stats": "tsx scripts/psn-player-stats.ts",
    "psn:dlc-icons": "tsx scripts/backfill-dlc-icons.ts",
    "db:trophy-slugs": "tsx scripts/backfill-trophy-slugs.ts",
    "forums:seed": "tsx scripts/forums-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "next": "^15.5.26",
    "psn-api": "^2.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
