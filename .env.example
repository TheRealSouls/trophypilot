# PostgreSQL connection string. Neon's free tier works: use the direct (non-pooled) string.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Secret used to sign session cookies (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# PSN service account token (NPSSO). Leave empty to run in demo mode with a
# simulated provider and a fictional catalogue. When set, the site verifies PSN
# links, syncs real trophies and can look up any public PSN profile.
#   1. Sign in at https://www.playstation.com with a PSN account you control
#      (ideally a separate account made just for this site).
#   2. In the same browser, open https://ca.account.sony.com/api/v1/ssocookie
#   3. Copy the 64-character "npsso" value here, then restart the server.
#   4. Check it with: npm run psn:check -- SomeOnlineId
# Tokens last about two months. Signing out of playstation.com in that browser
# can invalidate it early.
PSN_NPSSO=""

# How many changed trophy lists one sync run processes. Big libraries import
# over several runs (the background loop after linking, Sync now, or the cron).
PSN_SYNC_TITLES_PER_RUN="200"
# How many trophy lists a sync fetches at the same time (10 measured best; 16 barely helps).
PSN_SYNC_CONCURRENCY="10"
# Sync cron (GET /api/cron/sync): how many due accounts to sync per call.
PSN_SYNC_PER_RUN="10"

# Players cron (GET /api/cron/players): how many tracked players to refresh per call, and
# whether to discover new players through public friends lists (off unless set to "on").
PSN_REFRESH_PER_RUN="10"
PSN_DISCOVERY="off"
PSN_DISCOVER_PER_RUN="20"
# The players cron also loads trophy lists for the newest games and re-fetches lists
# that gained DLC, for the home page's "New trophy lists" and "New DLC".
PSN_NEW_LISTS_PER_RUN="5"
PSN_GROWN_LISTS_PER_RUN="5"

# IGDB (free, via a Twitch developer app) fills in release dates, descriptions, genres,
# screenshots and trailers. Create an app at dev.twitch.tv/console, then copy its Client ID
# and a new Client Secret here. Leave empty to skip. See README, "Game details from IGDB".
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
# Games cron (GET /api/cron/games): how many games to look up per call.
IGDB_GAMES_PER_RUN="100"

# Secret for the background sync endpoint (GET /api/cron/sync with "Authorization: Bearer <secret>").
CRON_SECRET=""

# Public URL of the site, used for metadata and links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Formspree form that receives messages from the /contact page.
NEXT_PUBLIC_FORMSPREE_FORM_ID="xljdozjl"
# Google reCAPTCHA v2 ("I'm not a robot" checkbox) site key for the contact form. The matching
# secret key goes in Formspree (form settings), which checks the token. Empty = no captcha.
CAPTCHA_SITE_KEY=""

# Who runs the site. Shown in the terms of service and privacy policy.
SITE_OPERATOR_NAME=""
# No email address is shown anywhere: people reach you through the contact form (Formspree).
