// TrophyPilot data model.
// PostgreSQL (Neon's free tier works well). Enums are modelled as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Accounts ────────────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  username                String    @unique
  passwordHash            String
  country                 String? // ISO 3166-1 alpha-2
  bio                     String?
  avatarHue               Int       @default(215)
  // PUBLIC | FRIENDS | PRIVATE
  profileVisibility       String    @default("PUBLIC")
  showOnLeaderboards      Boolean   @default(true)
  showActivity            Boolean   @default(true)
  // FREE | PREMIUM: how often trophies sync (see src/lib/plans.ts).
  plan                    String    @default("FREE")
  // USER | MODERATOR | ADMIN (npm run user:role). Moderators look after members' posts; admins also run the site.
  role                    String    @default("USER")
  // Trusted members publish guides straight away; everyone else's wait for staff approval.
  trusted                 Boolean   @default(false)
  // The platinum they're proudest of, shown on their profile (one of their own platinum games).
  favouritePlatinumGameId String?
  // light | dark. The site is light unless the member picks dark in Settings; it never follows the device.
  theme                   String    @default("light")
  // Profile extras. The banner is artwork from one of the member's games (no uploads).
  bannerGameId            String?
  // Accent colour for the member's own profile page: "" (site red) or a preset key (see src/lib/profile-themes.ts).
  profileAccent           String    @default("")
  // Pre-built profile card theme ("" for none), see PROFILE_CARDS in src/lib/profile-themes.ts.
  profileCard             String    @default("")
  // Profile picture: null for the default (PSN avatar, else an initial), "preset:<key>" for a built-in picture,
  // "letter" for the initial, or the https icon of one of the member's games. No uploads.
  avatar                  String?
  youtubeUrl              String?
  twitchUrl               String?
  streamUrl               String?
  // "Playing now", set by the member; shown until nowPlayingUntil.
  nowPlayingGameId        String?
  nowPlayingUntil         DateTime?
  // EVERYONE | FRIENDS (friends and people they follow) | NOBODY
  allowMessages           String    @default("EVERYONE")
  // When the member clicked the link in their verification email. Only checked once email sending is set up
  // (RESEND_API_KEY); members who joined before that count as verified.
  emailVerifiedAt         DateTime?
  createdAt               DateTime  @default(now())

  psn                   PsnAccount?
  games                 UserGame[]
  trophies              UserTrophy[]
  sentRequests          Friendship[]         @relation("requester")
  receivedRequests      Friendship[]         @relation("addressee")
  guides                Guide[]
  tips                  Tip[]
  tipVotes              TipVote[]
  syncJobs              SyncJob[]
  titleSyncs            PsnTitleSync[]
  hostedSessions        Session[]
  sessionSlots          SessionMember[]
  forumThreads          ForumThread[]
  forumPosts            ForumPost[]
  bannerGame            Game?                @relation("banner", fields: [bannerGameId], references: [id], onDelete: SetNull)
  nowPlayingGame        Game?                @relation("nowPlaying", fields: [nowPlayingGameId], references: [id], onDelete: SetNull)
  gameRatings           GameRating[]
  guideFavourites       GuideFavourite[]
  vault                 VaultTrophy[]
  sessionComments       SessionComment[]
  following             Follow[]             @relation("follower")
  followers             Follow[]             @relation("following")
  posts                 Post[]
  ownedClubs            Club[]
  clubMemberships       ClubMember[]
  conversations         ConversationMember[]
  messages              Message[]
  reportsFiled          Report[]             @relation("reportsFiled")
  wishlist              WishlistGame[]
  favouritePlatinumGame Game?                @relation("favouritePlatinum", fields: [favouritePlatinumGameId], references: [id], onDelete: SetNull)
  reportsResolved       Report[]             @relation("reportsResolved")
  blocking              Block[]              @relation("blocker")
  blockedBy             Block[]              @relation("blocked")
  reactions             PostReaction[]
  uploads               Upload[]
}

// A member who doesn't want to hear from another: no messages, friend requests or follows either way.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Pictures members upload, stored in Supabase Storage (src/lib/uploads.ts). Rows count the daily limit
// and the total space used.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  // Path inside the storage bucket.
  path      String   @unique
  bytes     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PsnAccount {
  id               String    @id @default(cuid())
  userId           String    @unique
  onlineId         String    @unique
  accountId        String?
  avatarUrl        String?
  verified         Boolean   @default(false)
  verificationCode String?
  trophyLevel      Int       @default(1)
  levelProgress    Int       @default(0)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  // PENDING | ACCEPTED
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model SyncJob {
  id             String    @id @default(cuid())
  userId         String
  // RUNNING | SUCCESS | FAILED
  status         String    @default("RUNNING")
  // MANUAL (Sync now) | AUTO (background schedule) | IMPORT (first import after linking)
  trigger        String    @default("MANUAL")
  provider       String
  gamesSynced    Int       @default(0)
  trophiesSynced Int       @default(0)
  // Trophy lists still waiting for a later run (syncs are capped per run).
  remaining      Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, trigger, startedAt])
}

// When each PSN trophy list was last synced for a user, so a sync can resume
// where the previous capped run stopped and skip lists that haven't changed.
model PsnTitleSync {
  userId            String
  npCommunicationId String
  lastUpdated       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, npCommunicationId])
}

// Public PSN summary of every player the site has seen (profile lookups,
// imports and member syncs). All-time global and country leaderboards rank
// these real totals, so they include top hunters who never signed up.
model PsnPlayer {
  accountId         String    @id
  onlineId          String
  avatarUrl         String?
  country           String? // ISO 3166-1 alpha-2, decoded from the PSN npId
  isPlus            Boolean   @default(false)
  trophyLevel       Int       @default(1)
  levelProgress     Int       @default(0)
  platinum          Int       @default(0)
  gold              Int       @default(0)
  silver            Int       @default(0)
  bronze            Int       @default(0)
  points            Int       @default(0)
  // Trophy list set to private on PSN: kept off the boards.
  trophiesPrivate   Boolean   @default(false)
  // Asked to be removed from TrophyPilot (see terms, section 4).
  hidden            Boolean   @default(false)
  firstSeenAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // When we last fetched their recent games, and when we last read their public friends list (discovery).
  titlesRefreshedAt DateTime?
  friendsCheckedAt  DateTime?
  // From the player's full PSN games list (see refreshPlayer): games played and their average completion.
  gamesPlayed       Int?
  avgCompletion     Int?
  // Ultra rare trophies earned, summed over the lists counted so far, and how many lists are still to count.
  ultraRare         Int?
  ultraRarePending  Int?
  // The ultra rare tally per list, compact: { "NPWR12345_00": [count, lastUpdated in epoch seconds] }. One small
  // value per player instead of a row per game, since big libraries run to thousands of lists.
  rareLists         Json?

  titles    PsnPlayerTitle[]
  snapshots PsnPlayerSnapshot[]

  @@index([points])
  @@index([ultraRare])
  @@index([avgCompletion])
  @@index([country, points])
  @@index([onlineId])
  @@index([titlesRefreshedAt])
}

// A tracked player's recently played trophy lists: feeds "Latest platinums"
// and "Most played" on the home page without storing trophy-by-trophy history.
model PsnPlayerTitle {
  accountId         String
  npCommunicationId String
  gameId            String
  progress          Int       @default(0)
  hasPlatinum       Boolean   @default(false)
  platinumAt        DateTime? // exact, from the trophy list, once we've looked it up
  lastUpdated       DateTime
  // No longer used (the tally is PsnPlayer.rareLists); kept so the column isn't dropped.
  ultraRare         Int?
  rareCheckedAt     DateTime?

  player PsnPlayer @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  game   Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([accountId, npCommunicationId])
  @@index([platinumAt])
  @@index([lastUpdated])
}

// Point totals over time, so weekly and monthly boards can rank real PSN
// players by how much they gained, not only members with synced history.
model PsnPlayerSnapshot {
  id        String   @id @default(cuid())
  accountId String
  takenAt   DateTime @default(now())
  points    Int
  platinum  Int
  trophies  Int

  player PsnPlayer @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, takenAt])
  @@index([takenAt])
}

// ─── Game database ───────────────────────────────────────────────────────────

model Game {
  id                 String    @id @default(cuid())
  slug               String    @unique
  npCommunicationId  String?   @unique
  npServiceName      String? // "trophy" (PS3/PS4/Vita) | "trophy2" (PS5)
  title              String
  // Same value for every trophy list of one game (see titleKey() in src/lib/utils.ts).
  titleKey           String    @default("")
  platforms          String // comma separated: "PS5,PS4"
  publisher          String?
  developer          String?
  genre              String?
  releaseDate        DateTime?
  description        String?
  iconUrl            String?
  coverHue           Int       @default(220)
  // Community estimates
  difficulty         Float? // 1 to 10
  hoursToPlatinum    Int?
  playthroughs       Int?
  hasOnlineTrophies  Boolean   @default(false)
  trailerYoutubeId   String?
  // A PSN account known to own this title. Earn rates only come back from
  // per-user trophy calls, so this lets us fetch rarity for catalogue imports.
  psnSampleAccountId String?
  screenshots        String    @default("[]") // JSON array of image URLs / art seeds
  createdAt          DateTime  @default(now())

  // Members' ratings (see GameRating). rating is the average out of 5.
  rating             Float?
  ratingCount        Int       @default(0)
  // PLATINUM | COMPLETION when the platinum or 100% can't be earned any more (servers shut, glitched trophy). Set by admins.
  unobtainable       String?
  unobtainableReason String?
  // Trophies in the list according to PSN's game listings. When it grows past
  // what's stored (a DLC pack was added), the list is fetched again.
  definedTrophies    Int?
  // Tracked players and members who have any list of this game, for "Most played" (refreshGamePopularity).
  players            Int       @default(0)
  // When we last looked for sibling trophy lists (other regions/platforms) next to this one.
  siblingsProbedAt   DateTime?
  // IGDB match for release date, description, genre, screenshots and trailer.
  // igdbCheckedAt is set even when nothing matched, so a title is looked up once.
  igdbId             Int?
  igdbCheckedAt      DateTime?

  groups       TrophyGroup[]
  trophies     Trophy[]
  userGames    UserGame[]
  playerTitles PsnPlayerTitle[]
  guides       Guide[]
  sessions     Session[]
  forumThreads ForumThread[]
  ratings      GameRating[]
  bannerOf     User[]           @relation("banner")
  playingNow   User[]           @relation("nowPlaying")
  favouriteOf  User[]           @relation("favouritePlatinum")
  wishlistedBy WishlistGame[]

  @@index([title])
  @@index([titleKey])
}

model TrophyGroup {
  id          String    @id @default(cuid())
  gameId      String
  psnGroupId  String // "default", "001", ...
  name        String
  // PSN's own picture for the pack (each DLC has one); the game's icon is shown when it's missing.
  iconUrl     String?
  isDlc       Boolean   @default(false)
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  // Found when an already-loaded list was fetched again, so it's DLC released after we first saw the game.
  addedLater  Boolean   @default(false)

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  trophies Trophy[]

  @@unique([gameId, psnGroupId])
  @@index([isDlc, addedLater, createdAt])
}

model Trophy {
  id          String  @id @default(cuid())
  gameId      String
  groupId     String
  psnTrophyId Int
  // Address within the game: /games/hollow-knight/watcher (see src/lib/trophy-slug.ts).
  slug        String?
  name        String
  description String
  // PLATINUM | GOLD | SILVER | BRONZE
  type        String
  hidden      Boolean @default(false)
  missable    Boolean @default(false)
  online      Boolean @default(false)
  iconUrl     String?
  earnedRate  Float? // % of players who earned it; null until PSN reports it

  game     Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  group    TrophyGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  earners  UserTrophy[]
  tips     Tip[]
  steps    GuideStep[]
  sessions SessionTrophy[]
  vaults   VaultTrophy[]

  @@unique([gameId, psnTrophyId])
  @@unique([gameId, slug])
  @@index([name])
}

// ─── Trophy tracking ─────────────────────────────────────────────────────────

model UserGame {
  id           String    @id @default(cuid())
  userId       String
  gameId       String
  progress     Int       @default(0) // 0 to 100, across base game + DLC
  earnedCount  Int       @default(0)
  earnedBronze Int       @default(0)
  earnedSilver Int       @default(0)
  earnedGold   Int       @default(0)
  hasPlatinum  Boolean   @default(false)
  platinumAt   DateTime?
  completedAt  DateTime? // 100%
  firstEarned  DateTime?
  lastEarned   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model UserTrophy {
  id       String   @id @default(cuid())
  userId   String
  trophyId String
  earnedAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trophy Trophy @relation(fields: [trophyId], references: [id], onDelete: Cascade)

  @@unique([userId, trophyId])
  @@index([earnedAt])
  @@index([trophyId])
}

// ─── Guides & community ──────────────────────────────────────────────────────

model Guide {
  id             String   @id @default(cuid())
  slug           String   @unique
  gameId         String
  authorId       String
  title          String
  summary        String
  difficulty     Int // 1 to 10
  hoursEstimate  Int
  playthroughs   Int      @default(1)
  missableCount  Int      @default(0)
  onlineRequired Boolean  @default(false)
  videoYoutubeId String?
  views          Int      @default(0)
  // PUBLISHED | PENDING (waiting for staff) | REJECTED. Guides by staff and trusted members publish straight away.
  status         String   @default("PUBLISHED")
  // Why staff sent it back, shown to the author.
  reviewNote     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  game       Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  steps      GuideStep[]
  tips       Tip[]
  favourites GuideFavourite[]

  @@index([gameId])
  @@index([status, createdAt])
}

model GuideStep {
  id             String  @id @default(cuid())
  guideId        String
  order          Int
  // ROADMAP | MISSABLE | COLLECTIBLE | SPEEDRUN | TROPHY (how to earn one trophy; trophyId is set)
  kind           String
  title          String
  body           String
  trophyId       String?
  videoYoutubeId String?

  guide  Guide   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  trophy Trophy? @relation(fields: [trophyId], references: [id], onDelete: SetNull)

  @@index([guideId, kind, order])
}

model Tip {
  id        String   @id @default(cuid())
  authorId  String
  guideId   String?
  trophyId  String?
  body      String
  createdAt DateTime @default(now())

  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  guide  Guide?    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  trophy Trophy?   @relation(fields: [trophyId], references: [id], onDelete: Cascade)
  votes  TipVote[]

  @@index([trophyId])
  @@index([guideId])
}

model TipVote {
  userId String
  tipId  String
  value  Int // +1 / -1

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip  Tip  @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@id([userId, tipId])
}

// Lightweight trophy sessions (boosting / co-op meetups). Tier 3 expands this.
model Session {
  id          String   @id @default(cuid())
  hostId      String
  gameId      String
  title       String
  description String?
  platform    String
  startsAt    DateTime
  slots       Int      @default(4)
  createdAt   DateTime @default(now())

  host     User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  game     Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  members  SessionMember[]
  trophies SessionTrophy[]
  comments SessionComment[]

  @@index([startsAt])
}

// Trophies a session is going for, picked from the game's list.
model SessionTrophy {
  sessionId String
  trophyId  String

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trophy  Trophy  @relation(fields: [trophyId], references: [id], onDelete: Cascade)

  @@id([sessionId, trophyId])
}

model SessionComment {
  id        String   @id @default(cuid())
  sessionId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SessionMember {
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
}

// The service account's PSN session, shared by the web server, scripts and
// cron jobs. Refreshing it avoids signing in with the NPSSO over and over,
// which gets the NPSSO revoked.
model PsnAuthState {
  id               String   @id @default("service")
  // First 8 characters of the NPSSO this session came from, so a new token in .env starts a new session.
  npssoPrefix      String
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  refreshExpiresAt DateTime
  updatedAt        DateTime @updatedAt
}

// ─── Forums ─────────────────────────────────────────────────────────────────
// Sections are created by admins at /forums/manage. A section can hold
// sub-sections (one level) and threads. Posts keep their text when an
// account is deleted; the author shows as a deleted user.

model ForumSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  order       Int      @default(0)
  parentId    String?
  // Only admins can start threads here (announcements, rules).
  adminOnly   Boolean  @default(false)
  createdAt   DateTime @default(now())

  parent   ForumSection?  @relation("SubSections", fields: [parentId], references: [id], onDelete: Cascade)
  children ForumSection[] @relation("SubSections")
  threads  ForumThread[]

  @@index([parentId, order])
}

model ForumThread {
  id         String   @id @default(cuid())
  sectionId  String
  authorId   String?
  // Optional game the thread is about; it's listed on that game's page.
  gameId     String?
  title      String
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  // Denormalised so section pages don't count posts per thread.
  postCount  Int      @default(1)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  lastPostAt DateTime @default(now())

  section ForumSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  game    Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)
  posts   ForumPost[]

  @@index([sectionId, pinned, lastPostAt])
  @@index([gameId, lastPostAt])
}

model ForumPost {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ─── Ratings, favourites, the Trophy Vault ──────────────────────────────────

// One member's view of a game: how hard the platinum is (1 to 10) and how good the game is (1 to 5).
model GameRating {
  userId     String
  gameId     String
  difficulty Int?
  rating     Int?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}

model GuideFavourite {
  userId    String
  guideId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([userId, guideId])
}

// Up to five earned trophies a member shows off at the top of their profile.
model VaultTrophy {
  userId   String
  trophyId String
  position Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trophy Trophy @relation(fields: [trophyId], references: [id], onDelete: Cascade)

  @@id([userId, trophyId])
}

// ─── Community: follows, updates, clubs, messages ───────────────────────────

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// A short update on the community page, optionally posted in a club.
model Post {
  id        String   @id @default(cuid())
  authorId  String
  clubId    String?
  body      String
  createdAt DateTime @default(now())

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club      Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  reactions PostReaction[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([clubId, createdAt])
}

// One emoji reaction from one member on an update (REACTIONS in src/lib/community.ts).
model PostReaction {
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, emoji])
  @@index([createdAt])
}

model Club {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @default("")
  // Card theme for the club's header and listing, same choices as profile cards ("" for plain).
  theme        String    @default("")
  // Club picture: "preset:<key>" (the built-in pictures) or null for its initial.
  avatar       String?
  ownerId      String
  createdAt    DateTime  @default(now())
  // Clubs with no new members, updates or reactions for 5 days get a warning; 2 days later they're deleted
  // (src/lib/idle-clubs.ts). Set when the warning went out.
  idleWarnedAt DateTime?

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members ClubMember[]
  posts   Post[]
}

model ClubMember {
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

// Private messages. A conversation has two members, or more for a group chat.
model Conversation {
  id            String   @id @default(cuid())
  // Group chats have a name; one-to-one conversations show the other person's.
  title         String?
  isGroup       Boolean  @default(false)
  // Notices from TrophyPilot itself (for example a club about to be deleted): one member, no replies.
  system        Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// Contact form sends, for the one-message-a-day limit. `key` is "ip:<hash>" (a keyed hash, never the
// address itself) or "user:<id>". Rows older than two days are deleted as new messages come in.
model ContactSend {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// A member flagging something for staff (forum post, update, comment, tip, guide, message, profile).
model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  // FORUM_POST | POST | SESSION_COMMENT | TIP | GUIDE | MESSAGE | USER | CLUB
  targetType   String
  targetId     String
  // Where it is, for staff to open (a site path).
  url          String
  // SPAM | ABUSE | SPOILERS | INAPPROPRIATE | OTHER
  reason       String
  details      String?
  // A copy of the reported text as it was, in case it's edited or deleted.
  excerpt      String?
  // OPEN | REMOVED (content taken down) | DISMISSED
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter   User? @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("reportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Games a member wants to play (their wishlist), shown on their profile and the game page.
model WishlistGame {
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}
